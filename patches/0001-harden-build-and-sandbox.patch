+# Landlock is a syscall. The seccomp filter needs libseccomp.
+SECCOMP_CFLAGS := $(shell pkg-config --cflags libseccomp 2>/dev/null)
+SECCOMP_LIBS := $(shell pkg-config --libs libseccomp 2>/dev/null)
+ifeq ($(SECCOMP_LIBS),)
+    $(error libseccomp-devel is required)
+endif
+CXXFLAGS += $(SECCOMP_CFLAGS)
+LDFLAGS += $(SECCOMP_LIBS)
+
+# -fhardened when this compiler accepts it. The extra flags come after it so
+# -fstack-protector-all replaces the strong protector that -fhardened selects.
+# GCC spells the requested -fexeptions flag as -fexceptions.
+UNAME_M := $(shell uname -m)
+HARDEN_OK := $(shell $(CXX) -fhardened -E -x c++ /dev/null -o /dev/null >/dev/null 2>&1 && echo yes)
+ifeq ($(HARDEN_OK),yes)
+    HARDEN_CFLAGS := -fhardened
+else
+    HARDEN_CFLAGS := -U_FORTIFY_SOURCE -D_FORTIFY_SOURCE=3 -D_GLIBCXX_ASSERTIONS \
+        -ftrivial-auto-var-init=zero -fPIE -fstack-protector-strong -fstack-clash-protection
+    ifeq ($(UNAME_M),x86_64)
+        HARDEN_CFLAGS += -fcf-protection=full
+    endif
+    LDFLAGS += -pie -Wl,-z,now
+endif
+EXTRA_CFLAGS := -fsanitize=bounds-strict -fno-sanitize-recover=bounds \
+    -fno-strict-overflow -fstack-protector-all \
+    -fexceptions -fno-delete-null-pointer-checks
+EXTRA_LDFLAGS := -fsanitize=bounds-strict -Wl,-z,defs -Wl,--gc-sections -Wl,-z,relro
+CFLAGS += $(HARDEN_CFLAGS) $(EXTRA_CFLAGS)
+CXXFLAGS += $(HARDEN_CFLAGS) $(EXTRA_CFLAGS)
+LDFLAGS += $(EXTRA_LDFLAGS)
+
